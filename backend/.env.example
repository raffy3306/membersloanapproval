APP_NAME="Members Loan Approval"
APP_ENV=local
APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=members_loan_approval
DB_USERNAME=root
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5176,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5176
CORS_ALLOWED_ORIGINS_PATTERNS=/^http:\/\/localhost:[0-9]+$/,/^http:\/\/127\.0\.0\.1:[0-9]+$/

JWT_SECRET=your-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=24

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@membersloan.com"
MAIL_FROM_NAME="Members Loan Approval"
