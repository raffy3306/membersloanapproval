APP_NAME="Members Loan Approval"
APP_ENV=local
APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=Asia/Manila

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=members_loan_approval
DB_USERNAME=root
DB_PASSWORD=

# Local development may use file. Use redis for shared rate limiting/cache in production.
CACHE_STORE=file
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Keep local for development. Use s3 for shared storage across multiple app instances.
ATTACHMENT_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5176,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5176
CORS_ALLOWED_ORIGINS_PATTERNS=/^http:\/\/localhost:[0-9]+$/,/^http:\/\/127\.0\.0\.1:[0-9]+$/

JWT_SECRET=your-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=24

# Required by DatabaseSeeder; use a unique secret with at least 12 characters.
INITIAL_USER_PASSWORD=

EMAILJS_ENDPOINT=https://api.emailjs.com/api/v1.0/email/send
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_TIMEOUT=15
